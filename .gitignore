# Dependencies
node_modules/
**/node_modules/

# Production build outputs
dist/
dist-ssr/
client/dist/
.vercel/

# Environment files and credentials (never commit real .env files)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.*
**/.env.local

# Allow example environment files
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Explicitly ensure server resume files are preserved and tracked
!/server/files/*.pdf
!/server/files/*.docx
