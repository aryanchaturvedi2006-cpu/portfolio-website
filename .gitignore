# Dependencies
node_modules/
**/node_modules/

# Production build outputs
dist/
dist-ssr/
client/dist/
.vercel/

# Environment files (exclude secrets, credentials, and local environment files)
.env
.env.local
.env.*.local
.env.development
.env.production
*.env
**/.env
**/.env.*
!**/.env.example
!.env.example

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Explicitly ensure server resume files are preserved and tracked
!/server/files/*.pdf
!/server/files/*.docx
