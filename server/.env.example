# Server Port
PORT=5000

# MongoDB Atlas Connection String
# Replace <db_password> with your actual MongoDB Atlas database user password
MONGODB_URI=mongodb+srv://portfolioUser:<db_password>@cluster0.tayddhn.mongodb.net/portfolio?retryWrites=true&w=majority

# Legacy fallback support (optional)
# MONGO_URI=mongodb+srv://portfolioUser:<db_password>@cluster0.tayddhn.mongodb.net/portfolio?retryWrites=true&w=majority

# Allowed Frontend Origins for CORS (comma-separated if multiple)
# For local development: http://localhost:5173
# For production (Render): https://your-portfolio.vercel.app
CLIENT_URL=http://localhost:5173
